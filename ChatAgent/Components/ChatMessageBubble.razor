<div class="d-flex mb-2 @(Message.Role == ChatRole.User ? "justify-content-end" : "justify-content-start")">
    <div class="p-2 rounded @(Message.Role == ChatRole.User ? "bg-primary text-white" : "bg-light")" style="max-width: 75%; white-space: pre-wrap;">
        @Message.Text
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public required ChatMessage Message { get; set; }
}
