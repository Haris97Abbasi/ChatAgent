@page "/"
@rendermode InteractiveServer
@inject ChatSessionState ChatState
@inject IJSRuntime JS
@implements IDisposable
@implements IAsyncDisposable

<PageTitle>ChatAgent</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0">ChatAgent — @T("AppSubtitle")</h1>
    <div class="d-flex align-items-center gap-2">
        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="HandleReset" disabled="@ChatState.IsProcessing">
            @T("NewLabel")
        </button>
        <div class="btn-group btn-group-sm" role="group" aria-label="Language">
            <button type="button" class="btn @(ChatState.Language == UiLanguage.English ? "btn-secondary" : "btn-outline-secondary")"
                    @onclick="() => ChatState.SetLanguage(UiLanguage.English)">EN</button>
            <button type="button" class="btn @(ChatState.Language == UiLanguage.German ? "btn-secondary" : "btn-outline-secondary")"
                    @onclick="() => ChatState.SetLanguage(UiLanguage.German)">DE</button>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-7">
        <div class="border rounded d-flex flex-column" style="height: 65vh;">
            <div class="flex-grow-1 overflow-auto p-3" @ref="_messageListRef">
                @foreach (var message in ChatState.Messages)
                {
                    <ChatMessageBubble Message="message" />
                }
                @if (ChatState.IsProcessing)
                {
                    <div class="text-muted fst-italic">@T("AgentThinking")</div>
                }
            </div>

            <form class="border-top p-2 d-flex gap-2" @onsubmit="SendAsync">
                <input class="form-control" @bind="_input" @bind:event="oninput"
                       placeholder="@T("InputPlaceholder")" disabled="@ChatState.IsProcessing" />
                <button class="btn btn-primary" type="submit" disabled="@(ChatState.IsProcessing || string.IsNullOrWhiteSpace(_input))">
                    @T("Send")
                </button>
            </form>
        </div>
    </div>

    <div class="col-md-5">
        @if (ChatState.IsLabelReady)
        {
            <LabelPreviewCard Label="ChatState.CurrentLabel" Language="ChatState.Language" />
        }
    </div>
</div>

<p class="text-muted small text-center mt-2 mb-0">@T("VerificationNote")</p>

@code {
    private string _input = "";
    private ElementReference _messageListRef;
    private IJSObjectReference? _module;
    private int _lastRenderedMessageCount;

    private string T(string key) => UiText.Get(key, ChatState.Language);

    protected override void OnInitialized()
    {
        ChatState.StateChanged += OnChatStateChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./Components/Pages/Home.razor.js");
        }

        if (_module is not null && ChatState.Messages.Count != _lastRenderedMessageCount)
        {
            _lastRenderedMessageCount = ChatState.Messages.Count;
            await _module.InvokeVoidAsync("scrollToBottom", _messageListRef);
        }
    }

    private void OnChatStateChanged() => InvokeAsync(StateHasChanged);

    private async Task SendAsync()
    {
        var text = _input.Trim();
        _input = "";
        await ChatState.SendUserMessageAsync(text);
    }

    private void HandleReset()
    {
        _input = "";
        ChatState.Reset();
    }

    public void Dispose()
    {
        ChatState.StateChanged -= OnChatStateChanged;
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}
